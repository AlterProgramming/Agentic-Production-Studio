{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agentic-production-studio.local/schemas/mnemonic-scene.schema.json",
  "title": "Mnemonic Separation Scene",
  "type": "object",
  "required": ["scene_id", "layers", "reuse_checks"],
  "properties": {
    "scene_id": {"type": "string", "minLength": 1},
    "layers": {
      "type": "object",
      "required": ["embodied", "artifacts", "interactions", "provenance", "hypotheses"],
      "properties": {
        "embodied": {"type": "array", "minItems": 1},
        "artifacts": {"type": "array", "minItems": 1},
        "interactions": {"type": "array"},
        "provenance": {"type": "array", "minItems": 1},
        "hypotheses": {"type": "array", "minItems": 1}
      },
      "additionalProperties": false
    },
    "reuse_checks": {
      "type": "object",
      "required": ["reopen", "alternate_pose", "alternate_garment_state", "alternate_camera"],
      "properties": {
        "reopen": {"type": "boolean"},
        "alternate_pose": {"type": "boolean"},
        "alternate_garment_state": {"type": "boolean"},
        "alternate_camera": {"type": "boolean"}
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": true
}
