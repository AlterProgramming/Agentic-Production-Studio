{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://brightengine.live/contracts/video-project.schema.json",
  "title": "Production Studio Video Project",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "project_id", "output_root", "shots"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "project_id": {"type": "string", "minLength": 1},
    "output_root": {"type": "string", "minLength": 1},
    "resume_project_id": {"type": ["string", "null"]},
    "rate_policy": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "requests_per_minute": {"type": "number", "exclusiveMinimum": 0},
        "burst": {"type": "integer", "minimum": 1},
        "max_retries": {"type": "integer", "minimum": 0},
        "base_backoff_seconds": {"type": "number", "minimum": 0},
        "max_backoff_seconds": {"type": "number", "minimum": 0}
      }
    },
    "shots": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["shot_id", "title", "prompt", "reference_image"],
        "properties": {
          "shot_id": {"type": "string", "minLength": 1},
          "title": {"type": "string", "minLength": 1},
          "prompt": {"type": "string", "minLength": 1},
          "reference_image": {"type": "string", "minLength": 1},
          "model": {"type": "string", "default": "sora-2"},
          "seconds": {"enum": [4, 8, 12]},
          "size": {"enum": ["720x1280", "1280x720", "1024x1792", "1792x1024"]},
          "dependencies": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
          "preserve": {"type": "array", "items": {"type": "string"}},
          "motion": {"type": "array", "items": {"type": "string"}},
          "avoid": {"type": "array", "items": {"type": "string"}},
          "candidates": {"type": "integer", "minimum": 1},
          "repair_budget": {"type": "integer", "minimum": 0},
          "target_score": {"type": "number", "minimum": 0, "maximum": 1}
        }
      }
    }
  }
}
